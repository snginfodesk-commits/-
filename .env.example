# Facebook Marketing API Credentials
# ====================================
# 1. Go to https://developers.facebook.com/
# 2. Create an app or use an existing one
# 3. Generate a User Access Token with ads_read permission
# 4. Find your Ad Account ID in Facebook Ads Manager (format: act_XXXXXXXXXX)

FB_ACCESS_TOKEN=your_access_token_here
FB_AD_ACCOUNT_ID=act_XXXXXXXXXX
FB_APP_SECRET=your_app_secret_here

# Optional: Target CPL used to flag scaling opportunities (default: 50.0)
TARGET_CPL=50.0
